<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogBackdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_scrim"
    android:clickable="true"
    android:focusable="true">

    <!-- Central Modal Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDialogContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Header Bar -->
            <RelativeLayout
                android:id="@+id/headerBar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#F8F9FA"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Back Button -->
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/dialog_back"
                    android:src="@drawable/ic_arrow_back_24"
                    android:visibility="gone"
                    app:tint="@color/text_primary" />

                <!-- Header Title -->
                <TextView
                    android:id="@+id/tvDialogTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/dialog_title_guide"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Auto-close Countdown / Indicator -->
                <TextView
                    android:id="@+id/tvAutoCloseTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/btnClose"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:text="60s"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />

                <!-- Big Close Button -->
                <ImageButton
                    android:id="@+id/btnClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/dialog_close"
                    android:src="@drawable/ic_close_24"
                    app:tint="@color/text_primary" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0" />

            <!-- Content Area Container -->
            <FrameLayout
                android:id="@+id/contentArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="360dp"
                android:padding="20dp">

                <!-- 1. CATEGORY SELECTOR (Stage 1: Exactly TWO CARDS) -->
                <LinearLayout
                    android:id="@+id/viewCategorySelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:visibility="visible">

                    <!-- Pork Special Card -->
                    <LinearLayout
                        android:id="@+id/cardCategoryPork"
                        android:layout_width="0dp"
                        android:layout_height="320dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_category_pork"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <ImageView
                            android:id="@+id/ivPorkCategoryIcon"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:contentDescription="@string/category_pork_title"
                            android:src="@drawable/ic_pork_category" />

                        <TextView
                            android:id="@+id/tvPorkCategoryTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/category_pork_title"
                            android:textColor="@color/text_accent_pork"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPorkCategoryDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/category_pork_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Beef Rib Card (Single Prime Rib) -->
                    <LinearLayout
                        android:id="@+id/cardCategoryBeef"
                        android:layout_width="0dp"
                        android:layout_height="320dp"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/bg_category_beef"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <ImageView
                            android:id="@+id/ivBeefCategoryIcon"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:contentDescription="@string/category_beef_title"
                            android:src="@drawable/ic_beef_rib" />

                        <TextView
                            android:id="@+id/tvBeefCategoryTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/category_beef_title"
                            android:textColor="@color/text_accent_beef"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBeefCategoryDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/category_beef_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. PORK LIST VIEW (Stage 2A) -->
                <LinearLayout
                    android:id="@+id/viewPorkList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvPorkListHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="돼지고기 특수부위를 선택해 주세요"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPorkCuts"
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        android:clipToPadding="false"
                        android:scrollbars="vertical" />
                </LinearLayout>

                <!-- 3. MEAT DETAIL VIEW (Stage 2B - Shared for Pork cut or Beef Rib) -->
                <LinearLayout
                    android:id="@+id/viewMeatDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:visibility="gone">

                    <!-- Left Column: Diagrams & Position -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivDetailDiagram"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/pig_diagram_neck"
                            android:contentDescription="부위 위치도" />

                        <TextView
                            android:id="@+id/tvDetailCutPosition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="#F5F5F5"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp"
                            android:text="돼지 목덜미 위쪽 살코기"
                            android:textColor="@color/brand_primary_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Right Column: Name, Taste, Texture, Description, Recommendations -->
                    <ScrollView
                        android:layout_width="0dp"
                        android:layout_height="320dp"
                        android:layout_weight="1.2">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDetailMeatName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="꼬들목살"
                                android:textColor="@color/text_primary"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailDescription"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:lineSpacingExtra="3dp"
                                android:text="돼지 한 마리에서 400g만 나오는 특수부위..."
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                            <!-- Taste Box -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="#FFF8E1"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="맛과 풍미"
                                    android:textColor="#F57F17"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDetailTaste"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="고소함이 짙고 감칠맛이 깊음"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- Texture Box -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="#E8F5E9"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="식감"
                                    android:textColor="#2E7D32"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDetailTexture"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="꼬들꼬들하고 탄력 넘치는 식감"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- Recommendation Box -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="#FFEBEE"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="매장 추천 꿀팁"
                                    android:textColor="#C62828"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDetailRecommendation"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="첫 점은 구운 소금에 살짝 찍어 본연의 맛을 즐기세요."
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </ScrollView>
                </LinearLayout>

            </FrameLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
