<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Horizontal container for bubble + character -->
    <LinearLayout
        android:id="@+id/characterBubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Speech Bubble (Positioned left or right dynamically) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSpeechBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="@color/speech_bubble_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="true">

            <TextView
                android:id="@+id/tvSpeechBubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="220dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="@string/default_speech_bubble"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <!-- Floating Character Button -->
        <FrameLayout
            android:id="@+id/btnCharacter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivCharacterIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_mascot_character" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
