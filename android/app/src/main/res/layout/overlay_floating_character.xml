<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Horizontal container for bubble + character -->
    <LinearLayout
        android:id="@+id/characterBubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Ultra-Mini Speech Bubble -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSpeechBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            app:cardBackgroundColor="@color/speech_bubble_bg"
            app:cardCornerRadius="5dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp">

                <!-- Language Code Header: KR / EN / JA -->
                <TextView
                    android:id="@+id/tvBubbleLangBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:background="@drawable/bg_speech_bubble"
                    android:backgroundTint="#FFF0F5"
                    android:paddingStart="3dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="3dp"
                    android:paddingBottom="0dp"
                    android:text="KR"
                    android:textColor="#E11D48"
                    android:textSize="6.5sp"
                    android:textStyle="bold" />

                <!-- Speech Bubble Text Content -->
                <TextView
                    android:id="@+id/tvSpeechBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="90dp"
                    android:text="@string/default_speech_bubble"
                    android:textColor="@color/text_primary"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Ultra-Mini Floating Character Button -->
        <FrameLayout
            android:id="@+id/btnCharacter"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivCharacterIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_mascot_character" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
